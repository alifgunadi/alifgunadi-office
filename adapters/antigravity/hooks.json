{
  "alifgunadi-office": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./agy-office-hook.js",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./agy-office-hook.js",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./agy-office-hook.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./agy-office-hook.js",
        "timeout": 5
      }
    ]
  }
}
